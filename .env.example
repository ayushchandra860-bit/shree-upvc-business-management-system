# Server
NODE_ENV=development
PORT=10000
SESSION_SECRET=replace-with-a-long-random-secret

# Supabase PostgreSQL connection string.
# Use the Supabase connection pooler URI or direct database URI.
SUPABASE_DATABASE_URL=postgresql://postgres.project_ref:password@aws-0-region.pooler.supabase.com:6543/postgres
DB_SSL=true

# Frontend dev origin
CLIENT_ORIGIN=http://localhost:5173

# Used by npm run seed:admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@shreeupvc.com
ADMIN_PASSWORD=ChangeThisStrongPassword123
